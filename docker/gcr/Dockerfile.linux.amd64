FROM harness0.harness.io/oci/docker_artifacts/hhi/harnessos-alpine:1 AS hhi-ca-certificates
RUN apk add --no-cache 'ca-certificates>=20261020-r0'

FROM harnesscommunity/kaniko-executor:1.25.16-linux-amd64
COPY --from=hhi-ca-certificates /etc/ssl/certs/ca-certificates.crt /kaniko/ssl/certs/hhi/ca-certificates.crt
ENV SSL_CERT_FILE=/kaniko/ssl/certs/hhi/ca-certificates.crt SSL_CERT_DIR=/kaniko/ssl/certs/hhi
ENV KANIKO_VERSION=1.25.16
ADD release/linux/amd64/kaniko-gcr /kaniko/
ENTRYPOINT ["/kaniko/kaniko-gcr"]
COPY --from=hhi-ca-certificates /etc/ssl/certs/ca-certificates.crt /kaniko/ssl/certs/ca-certificates.crt
